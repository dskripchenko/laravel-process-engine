{
    "name": "dskripchenko/laravel-process-engine",
    "description": "Laravel bridge for dskripchenko/process-engine: database store, queue workers, scheduler, artisan commands, a Processes facade, Eloquent model binding and state projection.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "workflow",
        "state-machine",
        "statechart",
        "process-engine",
        "durable-execution",
        "saga"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-process-engine",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "dskripchenko/process-engine": "^1.0",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "dskripchenko/laravel-delayed-process": "Run delayed processes from a process and wait for their completion"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\LaravelProcessEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\LaravelProcessEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\LaravelProcessEngine\\ProcessEngineServiceProvider"
            ],
            "aliases": {
                "Processes": "Dskripchenko\\LaravelProcessEngine\\Facades\\Processes"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
